# Copier ce fichier en .env (jamais versionné) puis remplir les valeurs.
#   cp .env.example .env

# Clé de signature des jetons de connexion : au moins 32 caractères, aléatoire.
# Pour en générer une :  openssl rand -base64 48
JWT_SECRET=

# Durée de validité d'un jeton (ISO-8601). PT2H = 2 heures.
JWT_EXPIRATION=PT2H

# Premier administrateur, créé au démarrage s'il n'existe encore aucun admin.
ADMIN_EMAIL=admin@orbittrack.local
ADMIN_PASSWORD=
